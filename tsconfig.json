{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es6",
    "module": "commonjs",
    "lib": [
      "es6"
    ],
    "inlineSourceMap": true,
    "inlineSources": true,
    "declaration": true,
    "allowJs": true,
    "outDir": "build",
    "rootDir": ".",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "dist",
    "build",
    "config",
    "mocks"
  ]
}